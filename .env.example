# Local development only. Copy to .env in the project root; never commit .env.
# Use a separate YantraSetu database, not an existing academic/project database.
PGHOST=localhost
PGPORT=5432
PGDATABASE=yantrasetu
PGUSER=yantrasetu
PGPASSWORD=
# Optional DATABASE_URL overrides the PG* connection fields; URL-encode its password.
# DATABASE_URL=postgresql://user:encoded-password@localhost:5432/yantrasetu
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
OTP_SECRET=
APP_ENV=development
SMS_PROVIDER=development
FRONTEND_ORIGIN=http://localhost:5173
# Optional disposable test DB; never point at a live/shared database:
# TEST_DATABASE_URL=postgresql://user:encoded-password@localhost:5432/yantrasetu_test

# Email login: disabled (default), development (simulation only), or smtp.
# Use smtp for real emails; SMTP acceptance is not a guarantee of inbox delivery.
EMAIL_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# Web application client ID, configured with your exact frontend origin.
# This flow uses Google Identity Services ID tokens, not an OAuth client secret.
GOOGLE_CLIENT_ID=
